{
  "family": "claims-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::954975554867:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "claims-service",
      "image": "954975554867.dkr.ecr.us-east-1.amazonaws.com/claims-service:latest",
      "essential": true,
      "portMappings": [
  {
    "containerPort": 8080,
    "protocol": "tcp"
  }
],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/claims-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
